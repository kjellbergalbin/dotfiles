# Navigation
alias ll="ls -lh"
alias la="ls -lah"
alias ..="cd ../"
alias ...="cd ../../"
alias ....="cd ../../../"

# Git
alias gstat="git status"
alias gpull="git pull"
alias gs="git switch"
alias create="git switch -c"
alias log="git log --oneline"
alias main="git switch main && git pull"

# Tools
alias v="vim"
alias activate="source venv/bin/activate.fish"
